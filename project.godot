; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MasterWork"
run/main_scene="uid://dl4tmx46jq22n"
config/features=PackedStringArray("4.5", "GL Compatibility")

[autoload]

SceneManager="*res://common/scene_manager.gd"
XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"
FireSpreading="*res://engine/fire_spreading/fire_spreading.gd"
Constants="*res://engine/constants.gd"
GameCore="*res://engine/engine.gd"
ItemsCollection="*res://engine/items/items_collection.gd"
Metrics="*res://common/metrics.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/vsync/vsync_mode=0

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg")

[filesystem]

import/blender/enabled=false

